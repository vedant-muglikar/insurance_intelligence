# ML cost microservice (see ml_service/). Optional - the app falls back to the static benchmark.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=6000

# Saved policy analyses (Supabase). Server-side only: never prefix with NEXT_PUBLIC_ and never commit the real value.
# Without it the app still works; it just runs the LLM extraction on every upload.
# Run supabase/migrations/20261010000000_policy_cache.sql once before enabling.
SUPABASE_SERVICE_ROLE_KEY=
